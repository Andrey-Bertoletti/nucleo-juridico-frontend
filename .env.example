# ============================================================
# nucleo-juridico-frontend — variáveis de ambiente (exemplo)
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commite .env.local.
# ============================================================

# URL base da API (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Ambiente da aplicação: development | staging | production
NEXT_PUBLIC_APP_ENV=development

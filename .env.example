# ============================================================
# nucleo-juridico-frontend — variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie para .env.local (dev) e preencha com valores reais.
# Em produção, configure na Vercel (Settings → Environment Variables).
# NÃO COMMITE .env.local.
# ============================================================

# URL pública da API FastAPI. Sem barra no final.
# Dev:        http://localhost:8000
# Produção:   https://nucleo-juridico-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Credenciais públicas do Supabase. OBRIGATÓRIAS — o frontend usa para:
#   - troca de código no `/reset-password` (link do e-mail de convite/reset)
#   - login com Google (signInWithOAuth no `/login`)
# São chaves "anon" (públicas) — pode embarcar no bundle sem problema.
NEXT_PUBLIC_SUPABASE_URL=https://kyhspzjpvughewfwbiym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ambiente da aplicação: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# IMPORTANTE: variáveis com prefixo NEXT_PUBLIC_ são embutidas no bundle
# e VISÍVEIS no navegador. Nunca coloque aqui chaves secretas
# (como SUPABASE_SERVICE_ROLE_KEY).
